msgid "All projects"
msgstr "Tous les projets"

#: home/templates/home/blocks/open_projects.html:40
msgid "Vote open"
msgstr "Vote ouvert"

#: home/templates/home/blocks/open_projects.html:40
msgid "Ideas welcome"
msgstr "Idées bienvenues"

