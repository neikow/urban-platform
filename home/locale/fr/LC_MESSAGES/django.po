#, python-format
msgid "Until %(date)s"
msgstr "Jusqu'au %(date)s"

#: home/templates/home/blocks/open_projects.html:50
msgid "Take part"
msgstr "Participer"

#: home/templates/home/blocks/open_projects.html:57
msgid ""
"No consultation is open right now: this block is hidden on the website until "
"one opens."
msgstr ""
"Aucune consultation n'est ouverte : ce bloc reste masqué sur le site jusqu'à "
"la prochaine."

#: home/templates/home/blocks/upcoming_events.html:6
msgid "All events"
msgstr "Tout l'agenda"

#: home/templates/home/blocks/upcoming_events.html:29
msgid "Online"
msgstr "En ligne"

#: home/templates/home/blocks/upcoming_events.html:38
msgid "Details"
msgstr "Détails"

#: home/templates/home/blocks/upcoming_events.html:46
msgid ""
"No event is planned: this block is hidden on the website until one is "
"published."
msgstr ""
"Aucun événement n'est prévu : ce bloc reste masqué sur le site jusqu'à la "
"publication du prochain."

