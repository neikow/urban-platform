# One website of the platform (deploy/tenant/compose.yml). Written by the
# deployment agent from the control plane, or by hand for a manual install.

# --- Identity -------------------------------------------------------------------
# Compose project name and router name: lowercase letters, digits, dashes.
TENANT_SLUG=aix
# Public hostname, served over HTTPS by the edge proxy.
TENANT_HOSTNAME=aix.example.org

# --- Release --------------------------------------------------------------------
IMAGE=ghcr.io/neikow/urban-platform
# A version (v1.2.0) or a build of the saas branch (saas-<commit>).
IMAGE_TAG=saas

# --- Secrets (generated once, never changed) ------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DB_PASSWORD=

# --- The website (core.tenant: applied at every deployment, see the README) ------
WEBSITE_NAME=Aix Ensemble
TENANT_ADMIN_EMAIL=admin@aix.example.org
# INSEE code of the commune or arrondissement.
TENANT_TERRITORY=13001
TENANT_CONTACT_EMAIL=bonjour@aix.example.org

# --- Email (Brevo) --------------------------------------------------------------
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=noreply@aix.example.org
# Empty: the website's name.
DEFAULT_FROM_NAME=

# --- Optional -------------------------------------------------------------------
SENTRY_DSN=
ANALYTICS_SCRIPT_TAG=
# GUNICORN_WORKERS=2
# GUNICORN_THREADS=4
# CELERY_CONCURRENCY=1

# --- Edge proxy (Traefik on the host) --------------------------------------------
# EDGE_NETWORK=urban-edge
# EDGE_ENTRYPOINT=websecure
# EDGE_CERT_RESOLVER=letsencrypt
